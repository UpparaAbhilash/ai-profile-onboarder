# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Europe/Berlin
RESUME_MAX_UPLOAD_MB=5
RESUME_MAX_PAGES=10

# Database (Phase 3)
DB_NAME=profile_onboarder
DB_USER=onboarder_user
DB_PASSWORD=change-me

DB_PORT=3306

# OpenAI (Phase 5)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=60

# Email (Phase 7)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Celery / Redis (Phase 11)
CELERY_BROKER_URL=redis://localhost:6379/0