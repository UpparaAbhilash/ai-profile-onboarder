# Copy to .env.docker and fill in real values. NEVER commit .env.docker.
# Used only by "docker compose". Avoid "$" and quotes in values.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Europe/Berlin
SITE_URL=http://127.0.0.1:8080

# Django -> MySQL connection (DB_HOST is the service name in docker-compose.yml)
DB_NAME=profile_onboarder
DB_USER=onboarder_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306

# MySQL container: creates the database and user on first start (same values as above)
MYSQL_DATABASE=profile_onboarder
MYSQL_USER=onboarder_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Celery / Redis (service name "redis")
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# OpenAI (leave the key empty to test without AI costs)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=60

# Email: printed in the "web" and "worker" logs
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Local Docker has no HTTPS: keep these off here, turn them on for the real server.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_HSTS_SECONDS=0